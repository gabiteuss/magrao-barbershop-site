# Copie este arquivo para .env e preencha. O .env NUNCA vai para o git nem para o site.

# --- Supabase (obrigatório) ---
# supabase.com > Account > Access Tokens > Generate new token
SUPABASE_ACCESS_TOKEN=
# Está no endereço do painel do projeto: supabase.com/dashboard/project/<ESTE-CODIGO>
SUPABASE_PROJECT_REF=

# Endereço do site (pode ter mais de um separado por vírgula; o primeiro é o principal)
SITE_URL=https://xn--magrobarbershop-nkb.com.br,https://seu-site.workers.dev,http://localhost:8080

# --- Pix ---
# "teste" (simulado) ou "mercadopago"
PAYMENT_PROVIDER=teste
# Mercado Pago > Suas integrações > Credenciais (comece pelas de TESTE)
MP_ACCESS_TOKEN=
# Mercado Pago > Webhooks > Assinatura secreta
MP_WEBHOOK_SECRET=

# --- WhatsApp ---
# "console" (só registra no painel) ou "meta" (WhatsApp Cloud API oficial)
WHATSAPP_PROVIDER=console
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_TEMPLATE_LANG=pt_BR
WHATSAPP_BARBEARIA=5519984094568

# --- Anti-robô no cadastro (opcional, grátis): Cloudflare > Turnstile ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- E-mail de "esqueci a senha" (opcional): ex. Resend, com o domínio próprio ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
